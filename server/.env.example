# Default AI provider. Supported values: gemini, openai.
AI_PROVIDER=gemini

# Google Gemini API key and model.
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional OpenAI API key and model (used only when AI_PROVIDER=openai).
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional provider request timeout in milliseconds (defaults to 60000).
AI_REQUEST_TIMEOUT_MS=
